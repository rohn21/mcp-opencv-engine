# ==============================================================================
# MCP OpenCV Engine — Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# Application Profile: dev, prod, test, docker, native
MCP_PROFILE=dev

# Execution Mode: auto (recommended), docker, native
RUNTIME_MODE=native

# Compute Device Target: auto (recommended), cpu, cuda, mps
DEVICE=auto

# Service Endpoints (Native execution defaults)
DETECTION_SERVICE_URL=http://localhost:8001
PROCESSING_SERVICE_URL=http://localhost:8002
OCR_SERVICE_URL=http://localhost:8003

# Service Ports
MCP_GATEWAY_PORT=8000
DETECTION_PORT=8001
PROCESSING_PORT=8002
OCR_PORT=8003

# MCP Transport: streamable-http (default for gateway), stdio, sse
MCP_TRANSPORT=streamable-http
SERVICE_TIMEOUT=30.0

# Filesystem Boundaries & Sandboxing
DATA_DIR=./data
ALLOWED_INPUT_DIRS=./data/inputs
ALLOWED_OUTPUT_DIR=./data/outputs

# Computer Vision & AI Models
YOLO_MODEL=yolov8n.pt
# YOLO_WEIGHTS_DIR=./

# OCR Settings
OCR_ENGINE=easyocr
OCR_USE_GPU=false
OCR_LANGUAGES=en
